# ── NotifyHub Configuration ───────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# ── Core ──────────────────────────────────────────────────────────────────────
NS_DATABASE_DSN=postgres://notif:notif@localhost:5432/notifdb?sslmode=disable
NS_REDIS_ADDR=localhost:6379
NS_JWT_SECRET=change-me-to-a-32-char-min-secret
NS_JWT_SERVICE_SECRET=change-me-to-a-service-secret

# ── Security ───────────────────────────────────────────────────────────────────
# 32-byte base64-encoded key for encrypting vendor configs in the DB.
# Generate with: openssl rand -base64 32
NS_SECURITY_VENDOR_CONFIG_ENCRYPTION_KEY=

# ── Pub/Sub (choose one) ──────────────────────────────────────────────────────
NS_PUBSUB_MODE=mock     # mock | kafka | redis | gcp
NS_PUBSUB_KAFKA_BROKERS=localhost:9092

# ── Workflow Engine ────────────────────────────────────────────────────────────
# temporal | cadence | standalone
NS_CADENCE_MODE=temporal
NS_CADENCE_HOST_PORT=localhost:7233

# ── Clerk Auth (optional) ──────────────────────────────────────────────────────
NS_CLERK_SECRET_KEY=
NS_CLERK_WEBHOOK_SECRET=

# ── Admin Bootstrap (optional) ─────────────────────────────────────────────────
NS_ADMIN_EMAIL=admin@example.com
NS_ADMIN_PASSWORD=change-me

# ── Logging ────────────────────────────────────────────────────────────────────
NS_LOG_LEVEL=debug
NS_LOG_FORMAT=console

# ── Environment Guard ──────────────────────────────────────────────────────────
# Set to "production" or "staging" to block debug mode
ENVIRONMENT=development
