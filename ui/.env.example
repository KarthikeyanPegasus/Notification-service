# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.

# Backend API base URL (proxied through Next.js rewrites at /v1/*)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Auth: Clerk ───────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_CLERK_ENABLED=false to use mock auth (no Clerk account needed).
# This is useful for local dev without a Clerk account.
NEXT_PUBLIC_CLERK_ENABLED=false

# When Clerk is enabled, you need real keys from https://dashboard.clerk.com
# Publishable key is safe to expose (NEXT_PUBLIC_* prefix intentional)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key — server-side ONLY, never expose to the browser
CLERK_SECRET_KEY=sk_test_...

# Optional: override Clerk post-sign-in redirect
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
